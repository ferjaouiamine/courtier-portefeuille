# Copier ce fichier en .env et adapter les valeurs.

# --- Base de données ---
# URL complète de connexion PostgreSQL (Docker local, Supabase ou Neon).
# Compte applicatif sans privilège BYPASSRLS.
DATABASE_URL=postgresql://courtier_app:mot-de-passe-app@localhost:5432/courtier_portefeuille
# Compte réservé aux migrations, jamais utilisé par le serveur HTTP.
MIGRATION_DATABASE_URL=postgresql://courtier_admin:mot-de-passe-admin@localhost:5432/courtier_portefeuille
# Activer uniquement pour charger le fichier Excel initial dans une base vide.
IMPORT_DONNEES=false

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Authentification ---
# Chaîne aléatoire longue, différente entre les environnements.
JWT_SECRET=change-moi-avec-une-valeur-aleatoire-longue
JWT_DUREE=12h
# Nombre maximal de tentatives de connexion avant blocage temporaire.
CONNEXION_TENTATIVES_MAX=5
CONNEXION_BLOCAGE_MINUTES=15

# --- Pièces jointes ---
# local en développement, s3 en production.
STOCKAGE_DRIVER=local
# S3_BUCKET=mon-bucket-prive
# S3_REGION=eu-west-3
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_SSE=AES256
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Relances automatiques (scripts/relances.js) ---
# Laisser vide pour désactiver l'envoi de SMS (la relance est quand même tracée en base).
SMS_API_URL=
SMS_API_CLE=
SMS_EXPEDITEUR=
